# Esempio di configurazione Nginx per AlphanoGdr
server {
    listen 80;
    server_name example.com;
    root /var/www/alphanogdr;
    index index.php;

    # Nega l'accesso a file nascosti, archivi, configurazioni e log
    location ~ /\.(?!well-known) {
        deny all;
    }

    location ~* \.(sql|log|bak|env|eml|lock|json)$ {
        deny all;
    }

    # Protegge le directory interne dell'applicazione
    location ~ ^/(?:\.git|config|database|private|tests|docs|vendor|third_party|templates|libs|bin|temp|sessione/log)(?:/|$) {
        deny all;
    }

    # Impedisce l'esecuzione di script all'interno delle cartelle di upload e profili
    location ~ ^/(?:uploads|profili/pg)/ {
        location ~ \.(php[0-9]?|phtml|phar|html?|svg|shtml|cgi|pl|py|sh)$ {
            deny all;
        }
    }

    # Routing principale
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Elaborazione PHP tramite FastCGI
    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass unix:/var/run/php/php8.4-fpm.sock;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }
}
