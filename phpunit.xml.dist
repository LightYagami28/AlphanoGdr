<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory="tests/runtime/.phpunit.cache"
         colors="true"
         failOnWarning="true">
  <testsuites>
    <testsuite name="unit">
      <directory suffix="Test.inc">tests/unit</directory>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory suffix=".inc.php">libs</directory>
    </include>
  </source>
</phpunit>
